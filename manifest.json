  ],
  "protocol_handlers": [
    {
      "protocol": "web+odiadev",
      "url": "/open?url=%s"
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/open-audio",
      "accept": {
        "audio/*": [".mp3", ".wav", ".ogg", ".m4a"]
      },
      "icons": [
        {
          "src": "/assets/img/icons/audio-file.png",
          "sizes": "48x48"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "id": "/?source=pwa",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "permissions": [
    "clipboard-write",
    "clipboard-read",
    "notifications",
    "microphone"
  ],
  "suggested_keyboard_shortcut": {
    "default": "Ctrl+Shift+K",
    "mac": "Command+Shift+K"
  },
  "version": "1.0.0",
  "dir": "ltr",
